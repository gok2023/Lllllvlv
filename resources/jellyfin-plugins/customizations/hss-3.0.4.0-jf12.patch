+    #indexPage .hss-focus > .hss-active .hss-progress { opacity: .9; }
+    @media (prefers-reduced-motion: no-preference) {
+        #indexPage .hss-focus > .card {
+            transition: transform 270ms cubic-bezier(.2,.75,.22,1) !important;
+        }
+    }
+}
+#indexPage .itemsContainer.hss-queue {
+    display: grid !important;
+    grid-auto-flow: column;
+    grid-template-rows: repeat(2, auto);
+    grid-auto-columns: min(86vw, 370px);
+    gap: .65rem 1.4rem;
+    justify-content: start;
+}
+#indexPage .hss-queue > .card { width: 100% !important; padding: 0; }
+#indexPage .hss-queue .cardBox {
+    display: grid;
+    grid-template-columns: min(45%, 176px) minmax(0, 1fr);
+    align-items: center;
+    gap: .15rem .65rem;
+    margin: 0;
+}
+#indexPage .hss-queue .cardBox > .cardScalable { grid-column: 1; grid-row: 1 / span 2; }
+#indexPage .hss-queue .cardBox > :is(.cardText,.cardFooter) {
+    grid-column: 2;
+    min-width: 0;
+    padding-inline: 0;
+    text-align: start !important;
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+}
+#indexPage .hss-queue .cardText-first { align-self: end; font-weight: 600; }
+#indexPage .hss-queue .cardText-secondary { align-self: start; font-size: .86em; opacity: .76; }
+#indexPage .hss-queue .card:is(:hover, :focus-within) .cardBox {
+    background: color-mix(in srgb, currentColor 5%, transparent);
+    border-radius: .55rem;
+}
+@media (prefers-reduced-motion: no-preference) {
+    #indexPage :is(.hss-nav,.hss-focus) .cardBox { transition: transform 180ms ease-out, translate 180ms ease-out; }
+    .hss-progress { transition: opacity 160ms ease-out; }
+}
